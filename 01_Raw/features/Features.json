    "project": "string, tên project trong projects.json (vd 'nestjs-backend')",
    "controller_or_entry": "string, đường dẫn tương đối đến file controller/handler chính",
    "api_endpoints": "string[], danh sách các prefix hoặc route chính (vd ['GET /api/v1/users', 'POST /api/v1/users'])",
    "related_db_schemas": "string[], danh sách các bảng/collections liên quan",
    "status": "draft | reviewed | stale",
    "last_synced": "YYYY-MM-DD hoặc null"
  },
