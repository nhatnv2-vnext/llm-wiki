# Nguồn env DUY NHẤT cho toàn monorepo.
# Copy file này thành .env.local rồi điền giá trị thật.
# Local dev (apps/web), script ingest, và docker compose đều đọc từ .env.local ở root.
# KHÔNG commit .env.local / .env.staging / .env.production.

# Google Gemini API key — dùng cho embedding (RAG).
GOOGLE_API_KEY=your-google-api-key-here

# Đường dẫn tuyệt đối tới thư mục 02_Wiki (local dev / ingest).
# Docker compose ghi đè thành /wiki, nên giá trị này chỉ cần cho chạy local.
WIKI_ROOT_PATH=/absolute/path/to/My_Project_Vault/02_Wiki

# Thư mục LanceDB (tương đối theo cwd khi chạy = apps/web).
# Docker compose ghi đè thành /data/lancedb.
LANCEDB_PATH=.lancedb

# ── Đăng nhập (auth) ────────────────────────────────────────────────────────
# Khóa bí mật ký JWT phiên đăng nhập. BẮT BUỘC, >= 32 ký tự.
# Sinh bằng: openssl rand -base64 32
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu

# Danh sách user được phép đăng nhập, dạng `email:bcryptHash` cách nhau dấu phẩy.
# Sinh hash bằng:  cd apps/web && npm run hash-password -- 'matkhau' email@example.com
# Ví dụ (KHÔNG dùng hash mẫu này cho thật):
#   AUTH_USERS="admin@example.com:$2b$10$abcdefghijklmnopqrstuv...,ban@example.com:$2b$10$..."
AUTH_USERS=email@example.com:bcrypt-hash-o-day
