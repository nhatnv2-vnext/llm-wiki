# OS
.DS_Store
Thumbs.db

# Editor scratch
*.swp
*.tmp

# Node
**/node_modules/

# Layer 3 — runtime
apps/System/node_modules/
apps/System/*.log

# Web app (Next.js) — build output & local env
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts
apps/web/.env*.local
apps/web/*.tsbuildinfo

# Turborepo
.turbo/
**/.turbo/

# Generated files — không commit
apps/web/scripts/ingest-rag.mjs
apps/web/.lancedb/

# Environment files — chỉ commit .env.example
.env.local
.env.staging
.env.production

# Auto-gen RAG index (rebuild bằng `npm run index-vault`)
02_Wiki/00_Dashboard/Vault_Index.json

# Tài liệu Drive (pull bằng `npm run sync-drive`) + output parse (npm run parse-docs).
# Đây là dữ liệu nguồn/sinh tự động, không commit; giữ .gitkeep.
01_Raw/drive_docs/*
!01_Raw/drive_docs/.gitkeep

# Obsidian per-user
.obsidian/workspace*.json
.obsidian/cache/

# Obsidian plugin binaries — team tự cài qua UI, chỉ commit data.json (settings)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/manifest.json
# (giữ lại data.json để chia sẻ cấu hình)
!.obsidian/plugins/*/data.json

# File rác Obsidian
Untitled.base
Untitled.md

# NOTE: 02_Wiki/05_Code_Graph/ ĐƯỢC commit (theo quyết định team) để
# người mở Obsidian không cần cài codegraph.

/.vscode

# CodeGraph Database & Cache
codegraph.sqlite
.codegraph/
