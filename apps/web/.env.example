# Đường dẫn tuyệt đối tới thư mục 02_Wiki của Obsidian vault.
# App đọc các file Markdown ở phía server từ đường dẫn này.
WIKI_ROOT_PATH=/absolute/path/to/My_Project_Vault/02_Wiki

# Đường dẫn thư mục LanceDB (vector DB local cho RAG).
# Mặc định ".lancedb" trong thư mục chạy app nếu không đặt.
LANCEDB_PATH=.lancedb

# Google Gemini API key (sẽ dùng ở giai đoạn sau, chưa bắt buộc ở GĐ1.1).
# GOOGLE_API_KEY=your-google-api-key
